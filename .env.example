# FramePilot secrets. Copy this file to ".env" (same folder) and fill it in.
# .env is in .gitignore: it never goes to GitHub. Never paste these values into code, chat or Git.

# Hugging Face token (model downloads): https://huggingface.co/settings/tokens
HF_TOKEN=

# Gemini API keys (https://aistudio.google.com/apikey). Add as many as you have, one per line:
# GEMINI_API_KEY, GEMINI_API_KEY_2, GEMINI_API_KEY_3, ...  The audio pieces are shared between all of them.
# Make each key in a DIFFERENT Google account / project: the free limits are counted per project.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
